<!doctype html>
<html>
  <body>
    <div style='background-color:#F5F5F5;color:#242424;font-family:"Helvetica Neue", "Arial Nova", "Nimbus Sans", Arial, sans-serif;font-size:16px;font-weight:400;letter-spacing:0.15008px;line-height:1.5;margin:0;padding:32px 0;min-height:100%;width:100%'>
      <table align="center" width="100%" style="margin:0 auto;max-width:600px;background-color:#F5F5F5" role="presentation" cellspacing="0" cellpadding="0" border="0">
        <tbody>
          <tr style="width:100%">
            <td>
              {{ template "header" . }}

              <div style="background-color:#ffffff;padding:16px 24px 24px 24px">
                <div style="padding:16px 0px 16px 0px">
                  <table align="center" width="100%" cellpadding="0" border="0" style="table-layout:fixed;border-collapse:collapse">
                    <tbody style="width:100%">
                      <tr style="width:100%">
                        <td style="box-sizing:content-box;vertical-align:middle;padding-left:0;padding-right:0">
                          <div style="padding:0px 0px 0px 0px">
                            <div style="font-size:14px;font-weight:normal;text-align:left;padding:0px 0px 0px 0px">
                              Receipt from Golang Studios, Inc.
                            </div>
                            <h1 style="font-weight:bold;text-align:left;margin:0;font-size:32px;padding:16px 0px 0px 0px">
                              {{ printf "$%.2f" .receipt.amount }}
                            </h1>
                            <div style="color:#474849;font-size:14px;font-weight:normal;text-align:left;padding:0px 0px 0px 0px">
                              Paid {{ .receipt.paid_on }}
                            </div>
                            <div style="padding:16px 0px 16px 0px">
                              <hr style="width:100%;border:none;border-top:1px solid #EEEEEE;margin:0" />
                            </div>
                            <div style="font-size:14px;font-weight:normal;text-align:left;padding:0px 0px 0px 0px">
                              <a href="{{ .url }}" style="color:#242424" target="_blank">Download receipt</a>
                            </div>
                          </div>
                        </td>
                        <td style="box-sizing:content-box;vertical-align:middle;padding-left:0;padding-right:0">
                          <div style="padding:0px 0px 0px 0px">
                            <div style="padding:0px 0px 0px 0px;text-align:right">
                              <a href="{{ .url }}" style="text-decoration:none" target="_blank"
                                ><svg xmlns="http://www.w3.org/2000/svg"
                                     role="img" aria-label="Your invoice has been paid."
                                     viewBox="0 0 215.6 281.6" width="92" height="120"
                                     style="width:92px;height:120px;max-width:100%;vertical-align:middle;display:inline-block">
                                  <g>
                                  <path fill="#8CC5E7" d="M207.3,44.6c-6.7-13.7-22.9-1.6-27-5.9c-21-21.6-46.4-27-66.3-28c0,0-9,0-11,0c-20,0.5-45.4,6.3-66.3,28 c-4.1,4.3-20.4-7.8-27,5.9c-7.7,16,15.7,17.6,14.5,24.7c-2.3,12.8-0.8,31.8,1,50.5C28,151.5,4.3,227.4,53.6,257.9 c9.3,5.8,34.4,9,56.2,9.5l0,0c0,0,0.1,0,0.1,0c0,0,0.1,0,0.1,0l0,0c21.8-0.5,43.9-3.7,53.2-9.5c49.4-30.5,25.7-106.4,28.6-138.1 c1.7-18.7,3.2-37.7,1-50.5C191.6,62.2,215,60.5,207.3,44.6z"/>
                                  <g>
                                  <path fill="#E0DEDC" d="M143.2,54.3c-33.4,3.9-28.9,38.7-16,50c24,21,49,0,46.2-21.2C170.9,62.7,153.6,53.1,143.2,54.3z"/>
                                  <circle fill="#111212" cx="145.5" cy="84.3" r="11.4"/>
                                  <circle fill="#FFFFFF" cx="142.5" cy="79.4" r="3.6"/>
                                  </g>
                                  <g>
                                  <path fill="#B8937F" d="M108.5,107c-16,2.4-21.7,7-20.5,14.2c2,11.8,39.7,10.5,40.9,0.6C129.9,113.3,114.8,106.1,108.5,107z"/>
                                  <path d="M98.2,111.8c-2.7,9.8,21.7,8.3,21.1,2c-0.3-3.7-3.6-8.4-12.3-8.2C103.6,105.7,99.4,107.2,98.2,111.8z"/>
                                  <path fill="#E0DEDC" d="M99,127.7c-0.9,0.4-2.4,10.2,2.2,10.7c3.1,0.3,11.6,1.3,13.6,0c3.9-2.5,3.5-8.5,1.3-10 C112.4,126,100,127.2,99,127.7z"/>
                                  </g>
                                  <g>
                                  <path fill="#E0DEDC" d="M73.6,54.3c33.4,3.9,28.9,38.7,16,50c-24,21-49,0-46.2-21.2C46,62.7,63.3,53.1,73.6,54.3z"/>
                                  <circle fill="#111212" cx="71.4" cy="84.3" r="11.4"/>
                                  <circle fill="#FFFFFF" cx="74.4" cy="79.4" r="3.6"/>
                                  </g>
                                  <path fill="#B8937F" d="M193.6,186.7c11,0.1,5.6-23.5-1.2-18.8c-3.3,2.3-3.9,7.6-3.9,12.1C188.5,182.5,190.5,186.6,193.6,186.7z"/>
                                  <path fill="#B8937F" d="M23.3,186.7c-11,0.1-5.6-23.5,1.2-18.8c3.3,2.3,3.9,7.6,3.9,12.1C28.4,182.5,26.4,186.6,23.3,186.7z"/>
                                  <path fill="#B8937F" d="M172.7,259.2c-6-8.9-11.4-2-20.1,2.4c-4.1,2.1,6.8,9.6,19,4C174.8,264.1,174.7,262.1,172.7,259.2z"/>
                                  <path fill="#B8937F" d="M44.2,260.2c6-8.9,11.4-2,20.1,2.4c4.1,2.1-6.8,9.6-19,4C42.1,265.1,42.2,263.1,44.2,260.2z"/>
                                  <path fill="#3C89BF" d="M188.6,47c-0.6,2.1,2.1,1.8,3.1,8.3c0.4,2.4,9-3.5,5.5-7.8C194.3,43.9,189.1,44.9,188.6,47z"/>
                                  <path fill="#3C89BF" d="M28.3,47c0.6,2.1-2.1,1.8-3.1,8.3c-0.4,2.4-9-3.5-5.5-7.8C22.5,43.9,27.7,44.9,28.3,47z"/>
                                  </g>
                                </svg></a>
                            </div>
                          </div>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>

                {{ template "details" .receipt }}
              </div>

              <div style="height:24px"></div>

              <div style="background-color:#ffffff;padding:16px 24px 24px 24px">
                <h3 style="font-weight:normal;text-align:left;margin:0;font-size:20px;padding:16px 0px 16px 0px">
                  Receipt #{{ .receipt.number }}
                </h3>
                <div style="color:#474849;font-size:14px;font-weight:normal;text-align:left;padding:16px 0px 16px 0px">
                  {{ .receipt.period }}
                </div>

                <div style="padding:0px 0px 0px 0px">
                  {{ range .items }}
                  <div style="padding:8px 0px 8px 0px">
                    <table align="center" width="100%" cellpadding="0" border="0" style="table-layout:fixed;border-collapse:collapse">
                      <tbody style="width:100%">
                        <tr style="width:100%">
                          <td style="box-sizing:content-box;vertical-align:middle;padding-left:0;padding-right:0">
                            <div style="padding:0px 0px 0px 0px">
                              <div style="font-size:14px;font-weight:bold;text-align:left;padding:0px 0px 0px 0px">
                                {{ .name }}
                              </div>
                              {{ if .detail }}
                              <div style="color:#474849;font-size:12px;font-weight:normal;text-align:left;padding:8px 0px 0px 0px">
                                {{ .detail }}
                              </div>
                              {{ end }}
                            </div>
                          </td>
                          <td style="box-sizing:content-box;vertical-align:middle;padding-left:0;padding-right:0">
                            <div style="padding:0px 0px 0px 0px">
                              <div style="font-size:14px;font-weight:bold;text-align:right;padding:0px 0px 0px 0px">
                                {{ printf "$%.2f" .amount }}
                              </div>
                            </div>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                  {{ end }}
                  <div style="padding:8px 0px 8px 0px">
                    <hr style="width:100%;border:none;border-top:1px solid #EEEEEE;margin:0" />
                  </div>
                </div>

                {{ template "totals" .receipt }}
              </div>

              {{ template "footer" . }}
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </body>
</html>
